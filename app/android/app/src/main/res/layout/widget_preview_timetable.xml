<?xml version="1.0" encoding="utf-8"?>
<!-- 小工具選取器裡那張預覽。

     **這是一份靜態的假資料，不是真的課表。** 它只在使用者「還沒把小組件
     放上桌面」的時候出現，那時候我們根本還沒有機會畫任何東西。

     為什麼不用 previewImage 放一張圖：那要維護一張跟著設計走的 PNG，
     而且它不會跟系統的深淺色走。previewLayout 是 Android 12 之後的做法，
     系統直接 inflate 它，深色模式和動態字級都自然對。

     排版刻意跟 widget_views.dart 畫出來的那張一致 ——
     預覽跟實物差太多，比沒有預覽更糟。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9 月 5 日"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_preview_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="星期五"
                android:textSize="11sp"
                android:textColor="@color/widget_preview_dim" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="現在"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_preview_pill"
            android:textColor="@color/widget_preview_accent_text" />
    </LinearLayout>

    <!-- 反白那一列 —— 「現在正在上的課」。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/widget_preview_pill">

        <LinearLayout
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="第 2-4 節"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_preview_accent_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:20–12:05"
                android:textSize="10sp"
                android:textColor="@color/widget_preview_accent_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="計算機程式設計"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_preview_accent_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="電機二館 302"
                android:textSize="11sp"
                android:textColor="@color/widget_preview_accent_text" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="第 6-7 節"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_preview_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13:10–15:00"
                android:textSize="10sp"
                android:textColor="@color/widget_preview_dim" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="線性代數"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_preview_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="綜合一館 201"
                android:textSize="11sp"
                android:textColor="@color/widget_preview_dim" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
